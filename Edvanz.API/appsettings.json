  // Public parent portal (parent.edvanz.io). PortalKey is a PLACEHOLDER — never commit the real
  // shared secret; it is the App Service setting "ParentPortal__PortalKey". An empty key makes
  // ParentPortalKeyFilter reject EVERY request (fail-closed), so a deployment that forgets the
  // setting serves nothing rather than everything. Flip "ParentPortal__Enabled" to false to take
  // the whole public surface down without a redeploy.
  // RequirePhone/RequireParentName default FALSE so the API can always ship BEFORE the portal build
  // that collects the field — flip "ParentPortal__RequirePhone" / "__RequireParentName" in App
  // Service settings once that portal drop is confirmed live (no redeploy). The two
  // UnknownStudentCodeReplies* budgets meter how often "that student code does not exist" may be
  // answered honestly before the endpoint reverts to the old silent payload; see
  // ParentPortalOptions for why honesty is budgeted rather than blanket-refused.
  "ParentPortal": {
    "Enabled": true,
    "PortalKey": "",
    "RequirePhone": false,
    "RequestsPerDevicePerHour": 10,
    "RequestsPerTeacherPerHour": 50,
    "UnknownStudentCodeRepliesPerDevicePerHour": 8,
    "UnknownStudentCodeRepliesPerTeacherPerHour": 40
  },
  // Mobile-app version gate (GET /api/app/version-status). MinSupportedBuild is a LOW floor (5) so no
  // real user is ever force-blocked by the default — only genuinely ancient builds (< 5) are forced;
  // LatestBuild = the current shipped build (15) so nobody is nagged yet either (updateMode "none").
  // Raise MinSupportedBuild (forces older builds) or LatestBuild (offers an optional update) via the
  // SuperAdmin App Version screen or App Service settings "AppVersion__Android__MinSupportedBuild" —
  // no redeploy needed (a saved DB row wins over these defaults).
  "AppVersion": {
    "Android": {
      "MinSupportedBuild": 5,
      "LatestBuild": 15,
      "LatestVersion": "2.3.4",
      "StoreUrl": "https://play.google.com/store/apps/details?id=io.edvanz.tutor"
    },
    "iOS": {
      "MinSupportedBuild": 5,
      "LatestBuild": 15,
      "LatestVersion": "2.3.4",
      "StoreUrl": "https://apps.apple.com/app/id6800229991"
    }
  },
  "ConnectionStrings": {
    // DESIGN-TIME PLACEHOLDER ONLY — never a real database. Runtime environments MUST supply
    // ConnectionStrings__con (Azure App Service setting in prod; appsettings.Development.json
    // locally). Program.cs refuses to start if it sees this marker at runtime, so a container
    // that boots without app settings (the App Service first-boot quirk) fails fast and clear
    // instead of dialing dead credentials. The marker keeps `dotnet ef migrations script`
    // working on CI, which builds the host but never connects.
    "con": "Server=localhost;Database=EDVANZ_DESIGN_TIME_ONLY;Integrated Security=True;TrustServerCertificate=True;"
  },
  "environmentVariables": {
    "ASPNETCORE_ENVIRONMENT": "Development"
  },
